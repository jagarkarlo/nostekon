---
import ProductLayout from '../../layouts/ProductLayout.astro';

export function getStaticPaths() {
  const pages = [
    {
      page: 'privacy', title: 'Privacy', lead: 'Your evidence belongs in the environment you choose.',
      sections: [
        { heading: 'Browser storage', paragraphs: [
          'Nostekon saves your theme preference in localStorage. Saved runs, suite originals, public keys and explicit trust choices are stored in IndexedDB in your browser, not in a project account. There is no account or cloud sync in the current application.',
          'You can delete saved evidence and public keys from Studio. Clearing this site\'s browser data removes its local databases and preferences. Clearing browser data does not delete files you have downloaded or copies stored by a local API or host job.',
        ] },
        { heading: 'Where files are evaluated', paragraphs: [
          'The public demo evaluates selected evidence in your browser with the Go WebAssembly engine. The installed Studio sends evidence and selected public keys to the API you run. Host lab jobs are a separate, explicitly enabled feature and keep job data in the configured local directory.',
          'Evidence can expose cluster names, object metadata and application details. Review files before importing or sharing them. Do not include passwords, tokens, private signing keys or production credentials.',
        ] },
        { heading: 'Hosting and external links', paragraphs: [
          'The application includes no advertising or third-party analytics scripts. The provider hosting a copy of this site, its reverse proxy and your local operator may still keep request logs. Their retention and policies depend on that deployment.',
          'GitHub links leave this site and are subject to GitHub\'s policies. Public issues and discussions are public; use private vulnerability reporting for security-sensitive findings.',
        ] },
      ],
    },
    {
      page: 'terms', title: 'Terms', lead: 'Experimental software, explicit execution boundaries.',
      sections: [
        { heading: 'Open-source software', paragraphs: [
          'Nostekon is pre-alpha software distributed under Apache-2.0. The license governs use, modification and redistribution of the software. This page describes operational limits; it does not replace the license or add a commercial service agreement.',
          'The software is provided as-is under the license. No recovery guarantee, service-level agreement, certification or paid support commitment is offered by this project.',
        ] },
        { heading: 'Use an isolated environment', paragraphs: [
          'Use disposable lab and restore clusters with credentials limited to resources you own or are authorized to test. Recovery drills can create, change and delete resources. Do not point them at production or share a privileged kubeconfig.',
          'The packaged application starts with lab execution disabled. Enabling the host runner is an operator decision, not an action taken by the browser demo. Keep the local API bound to localhost unless you add and validate your own access controls.',
        ] },
        { heading: 'Understand the result', paragraphs: [
          'A report evaluates the evidence it receives. A valid signature binds particular bytes to a key, not to a verified operator identity or trustworthy capture process. A signature never turns a failed restore into a successful one.',
          'Verification levels, provenance, local public-key trust and recovery outcomes are separate claims. Review their limits before using a result to make an operational decision.',
        ] },
      ],
    },
    {
      page: 'trademark', title: 'Trademark', lead: 'An open codebase and a distinct project identity.',
      sections: [
        { heading: 'The Nostekon name and logo', paragraphs: [
          'This project claims trademark rights in the Nostekon name and logo. The TM symbol indicates that claim; it is not a registration, a filing or a statement that the name has received legal clearance. This site does not claim registered trademark status.',
          'The notice covers the Nostekon wordmark and the stepping-stones logo. Trademark protection and registration requirements depend on jurisdiction and use.',
        ] },
        { heading: 'Refer to the project accurately', paragraphs: [
          'You may identify and discuss Nostekon accurately, including customary descriptions of the origin of the software. Do not imply that the project endorses your company, fork or service when it does not.',
          'Use a distinct name and identity for a modified product or independently operated service. Preserve applicable notices and explain the relationship to the original project clearly.',
        ] },
        { heading: 'Code rights remain separate', paragraphs: [
          'The software remains licensed under Apache-2.0. Section 6 of that license separates the software license from general permission to use project trademarks. This brand notice does not change the copyright or patent permissions granted by the license.',
          'For questions about a proposed brand use, contact the maintainers through the project repository. No exclusive rights or successful registration are guaranteed by adding TM to a name or logo.',
        ] },
      ],
    },
    {
      page: 'license', title: 'License', lead: 'Apache-2.0, with the source available to inspect and change.',
      sections: [
        { heading: 'Use, modify and distribute', paragraphs: [
          'The Nostekon repository is distributed under the Apache License, Version 2.0. It permits use, modification and redistribution subject to its conditions, including providing the license and retaining applicable notices. Consult the complete license for the authoritative terms.',
          'Dependencies retain their own licenses. This summary does not grant additional rights or replace the license text.',
        ] },
        { heading: 'Warranty and project identity', paragraphs: [
          'The software is provided as-is under the license, without the warranties described in section 7. Nostekon remains pre-alpha; inspect its documented limits before relying on it.',
          'The Apache license does not generally grant use of project trademarks. The Nostekon brand policy is separate from permission to use the code.',
        ] },
      ],
    },
  ];
  return pages.map(entry => ({ params: { page: entry.page }, props: entry }));
}

const { title, lead, sections } = Astro.props;
---
<ProductLayout title={title} description={lead} current="legal">
  <header class="page-title wrap">
    <p class="eyebrow">Nostekon / Legal</p>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
  </header>
  <div class="wrap">
    <div class="legal-body prose">
      {sections.map(section => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        </section>
      ))}
      <p class="legal-links">
        <a href="https://github.com/jagarkarlo/nostekon/blob/main/LICENSE">Complete license</a>
        <a href="https://github.com/jagarkarlo/nostekon/blob/main/SECURITY.md">Security policy</a>
        <a href="https://github.com/jagarkarlo/nostekon/issues">Project contact</a>
      </p>
    </div>
  </div>
</ProductLayout>