---
import { ClientRouter } from 'astro:transitions';
import { Moon, Sun } from '@lucide/astro';
import nostekonMark from '../content/docs/assets/nostekon-mark.svg?url';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  current: string;
}

const { title, description, current } = Astro.props;
const navigation = [
  { href: "/", label: "Overview", id: "overview" },
  { href: "/product/", label: "Product", id: "product" },
  { href: "/evidence/", label: "Evidence", id: "evidence" },
  { href: "/download/", label: "Download", id: "download" },
  { href: "/demo/index.html", label: "Live demo", id: "demo" },
  { href: "/roadmap/", label: "Roadmap", id: "roadmap" },
  { href: "/docs/", label: "Docs", id: "docs" },
];
const source = 'https://github.com/jagarkarlo/nostekon';
const footerGroups = [
  { title: 'Product', links: [
    ['Overview', '/'], ['Evidence', '/evidence/'], ['Studio', '/demo/index.html#/runs'],
    ['Policy suites', '/demo/index.html#/suite'], ['Roadmap', '/roadmap/'],
  ] },
  { title: 'Open Source', links: [
    ['Download', '/download/'], ['Self-host', '/docs/start/'], ['GitHub', source], ['Releases', `${source}/releases`],
    ['Contributing', `${source}/blob/main/CONTRIBUTING.md`], ['Issues', `${source}/issues`],
  ] },
  { title: 'Docs', links: [
    ['Getting started', '/docs/start/'], ['First restore drill', '/docs/guides/k3d-isolated-restore/'],
    ['Verification levels', '/docs/levels/'], ['Evidence format', '/docs/reference/drillrun-evidence/'],
    ['Drill specification', '/docs/reference/drill-spec/'],
  ] },
  { title: 'Legal', links: [
    ['Privacy', '/legal/privacy/'], ['Terms', '/legal/terms/'], ['Trademark', '/legal/trademark/'],
    ['License', '/legal/license/'], ['Security', `${source}/blob/main/SECURITY.md`],
  ] },
];
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f1318" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={nostekonMark} />
    <link rel="preload" href="/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} | Nostekon</title>
    <script is:inline>
      const readThemePreference = () => {
        try {
          const stored = localStorage.getItem('nostekon-theme');
          if (stored === 'light' || stored === 'dark') return stored;
        } catch {}
        return matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      };
      const applyThemePreference = (root = document.documentElement) => {
        const theme = readThemePreference();
        root.dataset.theme = theme;
        const themeColor = root.querySelector('meta[name="theme-color"]');
        if (themeColor) themeColor.content = theme === 'light' ? '#f6f7f9' : '#0f1318';
      };
      const renderThemeButton = (theme) => {
        const button = document.querySelector('[data-theme-toggle]');
        const label = `Switch to ${theme === 'dark' ? 'light' : 'dark'} mode`;
        button?.setAttribute('aria-label', label);
        button?.setAttribute('title', label);
      };
      const updateThemeButton = () => {
        applyThemePreference();
        renderThemeButton(document.documentElement.dataset.theme);
      };

      applyThemePreference();
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('nostekon-theme', next); } catch { /* storage unavailable */ }
        renderThemeButton(next);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#f6f7f9' : '#0f1318');
      });
      document.addEventListener('astro:before-swap', (event) => {
        applyThemePreference(event.newDocument.documentElement);
      });
      document.addEventListener('astro:after-swap', updateThemeButton);
      document.addEventListener('astro:page-load', updateThemeButton);
    </script>
    <ClientRouter />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label="Nostekon home" title="Nostekon name and logo are claimed trademarks"><img class="wordmark-mark" src={nostekonMark} width="28" height="28" alt="" /><span>Nostekon<sup aria-hidden="true">&trade;</sup></span></a>
        <nav class="nav" aria-label="Main navigation">
          {navigation.map((item) => (
            <a href={item.href} aria-current={current === item.id ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="masthead-tools">
          <a class="tool-link" href="https://github.com/jagarkarlo/nostekon" aria-label="GitHub repository">GitHub</a>
          <button class="theme-toggle" data-theme-toggle type="button" aria-label="Switch to light mode" title="Switch to light mode">
            <Sun size={18} data-theme-icon="sun" aria-hidden="true" />
            <Moon size={18} data-theme-icon="moon" aria-hidden="true" />
          </button>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-about">
            <a class="footer-brand" href="/" aria-label="Nostekon home"><img src={nostekonMark} width="28" height="28" alt="" /><span>Nostekon<sup aria-hidden="true">&trade;</sup></span></a>
            <p>Run an isolated recovery drill.<br />Inspect what survived.</p>
            <a class="footer-contact" href={`${source}/issues`}>Project contact</a>
          </div>
          {footerGroups.map(group => (
            <nav aria-label={`Footer ${group.title}`}>
              <h2>{group.title}</h2>
              <ul>{group.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
            </nav>
          ))}
        </div>
        <div class="footer-notice">
          <p>Pre-alpha software. Apache-2.0.</p>
          <p>Nostekon and its logo are claimed trademarks. <a href="/legal/trademark/">Brand policy</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
<script>
  let observer: IntersectionObserver | undefined;
  function initializeReveals() {
    observer?.disconnect();
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    observer = new IntersectionObserver(entries => {
      for (const entry of entries) if (entry.isIntersecting) {
        (entry.target as HTMLElement).dataset.visible = "true";
        observer?.unobserve(entry.target);
      }
    }, { threshold: 0.08 });
    for (const element of document.querySelectorAll<HTMLElement>(".section > .wrap")) {
      element.dataset.reveal = "true";
      element.dataset.visible = String(element.getBoundingClientRect().top < innerHeight);
      if (element.dataset.visible === "false") observer.observe(element);
    }
  }
  initializeReveals();
  document.addEventListener("astro:page-load", initializeReveals);
</script>
